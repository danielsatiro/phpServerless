{
    "name": "serverless/php",
    "description": "PHP Serverless",
    "type": "project",
    "require": {
        "bref/bref": "^3.0",
        "aws/aws-sdk-php": "^3.356",
        "monolog/monolog": "^3.9",
        "mailgun/mailgun-php": "^4.3",
        "symfony/http-client": "^7.3",
        "nyholm/psr7": "^1.8",
        "symfony/dotenv": "^7.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "Serverless\\Php\\": "src/",
            "App\\Handler\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Daniel Sátiro"
        }
    ],
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
